import { readdir, existsSync, writeFile } from "fs";
import { join } from "path";

const buildDir = "./dist";

// O package.json da raiz declara "type": "module". Cada pasta do build precisa
// do próprio package.json dizendo o formato dos seus arquivos .js; sem ele,
// dist/cjs herda "module" da raiz e o require() do pacote quebra.
const moduleTypeByDir = {
  esm: "module",
  cjs: "commonjs",
};

function createModulePackageJsons() {
  readdir(buildDir, function (err, dirs) {
    if (err) {
      throw err;
    }
    dirs.forEach(function (dir) {
      var moduleType = moduleTypeByDir[dir];
      if (moduleType) {
        var packageJsonFile = join(buildDir, dir, "/package.json");
        if (!existsSync(packageJsonFile)) {
          writeFile(
            packageJsonFile,
            new Uint8Array(Buffer.from(`{"type": "${moduleType}"}`)),
            function (err) {
              if (err) {
                throw err;
              }
            }
          );
        }
      }
    });
  });
}

createModulePackageJsons();
